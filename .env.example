# ==============================================================================
# JurisFlow — Configuração de Ambiente (.env.example)
# Triforce System | SaaS Jurídico Multi-Tenant
# ==============================================================================
# IMPORTANTE: Copie este arquivo para .env.local e preencha com as credenciais reais.
# NUNCA versione o arquivo .env.local ou qualquer arquivo contendo segredos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Auth, Storage & Cloud Services)
# ------------------------------------------------------------------------------
# URL do projeto Supabase (Região: São Paulo - sa-east-1)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Chave Pública / Anônima do Cliente (Suporta nomenclatura nova ou legada):
# Nova: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Legada: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Chave Privada do Servidor / Service Role (Suporta nomenclatura nova ou legada):
# ATENÇÃO: NUNCA exponha no cliente ou com prefixo NEXT_PUBLIC_
# Nova: SUPABASE_SECRET_KEY
# Legada: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY="your-secret-or-service-role-key"
# SUPABASE_SERVICE_ROLE_KEY="your-secret-or-service-role-key"

# Bucket privado do Supabase Storage
SUPABASE_STORAGE_BUCKET="jurisflow-documents"

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL (Prisma ORM & RLS)
# ------------------------------------------------------------------------------
# Conexão da Aplicação (Pooler / Porta 6543 ou 5432).
# RECOMENDADO: Usar papel de aplicação 'jurisflow_app' SEM BYPASSRLS
DATABASE_URL="postgresql://jurisflow_app:your_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão Direta (Session / Porta 5432).
# Usado exclusivamente para migrações do Prisma com usuário privilegiado (postgres)
DIRECT_URL="postgresql://postgres:your_password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Conexão do Banco de Testes Automatizados (PostgreSQL Local)
TEST_DATABASE_URL="postgresql://postgres:SENHA_LOCAL@localhost:5432/jurisflow_test"

# ------------------------------------------------------------------------------
# 3. Aplicação & Domínio
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Flag obrigatória para permitir execução do seed de demonstração (recusa em produção)
ALLOW_SEED="true"
